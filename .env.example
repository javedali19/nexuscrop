# ============================================================================
# NEXUS ERP + CRM + AI Telephony Platform - Environment Configuration
# Copy this file to '.env' and fill in the values for your environment.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE (REQUIRED)
# ----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
PORT=8080

# PostgreSQL Connection URL (Local or Cloud SQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform_db
DATABASE_MAX_CONNECTIONS=20

# JWT Authentication Secret (Minimum 32 characters)
JWT_SECRET=super-secret-jwt-key-min-32-chars-long!
TOKEN_EXPIRATION_HOURS=24

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ----------------------------------------------------------------------------
# 2. AI REASONING & COPILOT (REQUIRED FOR AI FEATURES)
# ----------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-1.5-pro

# Primary AI Key (Google Gemini)
GEMINI_API_KEY=

# Secondary / Fallback AI Keys
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_DEEP=

# ----------------------------------------------------------------------------
# 3. AI VOICE AGENT & TELEPHONY (REQUIRED FOR CALL CENTER / VOICE BOTS)
# ----------------------------------------------------------------------------
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Real-time Speech-To-Text (Deepgram Nova-2)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# Neural Voice Synthesis (ElevenLabs Turbo v2.5)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ----------------------------------------------------------------------------
# 4. PAYMENT GATEWAYS (REQUIRED FOR INVOICING & CHECKOUT)
# ----------------------------------------------------------------------------
# Domestic (India UPI & Netbanking)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# International (Credit Cards & Subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# 5. GOOGLE CLOUD PLATFORM (OPTIONAL - FOR PRODUCTION CLOUD DEPLOYMENT)
# ----------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=
GCP_STORAGE_BUCKET=
GCP_PUBSUB_TOPIC_EVENTS=
GCP_TASKS_QUEUE_NAME=
GCP_KMS_KEY_NAME=
GCP_IDENTITY_PLATFORM_PROJECT_ID=
GCP_IDENTITY_PLATFORM_API_KEY=

# ----------------------------------------------------------------------------
# 6. OBSERVABILITY & MONITORING (OPTIONAL)
# ----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
