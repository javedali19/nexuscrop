# ============================================================================
# NEXUS ERP + CRM + AI Telephony Platform - Environment Variables Template
# All secrets and sensitive values must be populated in local .env files.
# Do NOT commit actual credentials or secrets to version control.
# ============================================================================

# Application Environment
APP_ENV=
LOG_LEVEL=
PORT=

# Database & PostgreSQL
DATABASE_URL=
DATABASE_MAX_CONNECTIONS=

# Auth & Security
JWT_SECRET=
TOKEN_EXPIRATION_HOURS=

# Google Cloud Configuration
GCP_PROJECT_ID=
GCP_REGION=
GCP_PUBSUB_TOPIC_EVENTS=
GCP_TASKS_QUEUE_NAME=
GCP_STORAGE_BUCKET=
GCP_KMS_KEY_NAME=

# Google Cloud Identity Platform (GCIP / Firebase Auth)
GCP_IDENTITY_PLATFORM_PROJECT_ID=
GCP_IDENTITY_PLATFORM_API_KEY=
GCP_IDENTITY_PLATFORM_TENANT_ID=

# Observability & Sentry
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# AI Model Providers (OpenAI, Google Gemini, Anthropic, Groq)
AI_PROVIDER=
AI_MODEL_NAME=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_DEEP=

# Payment Gateways (Stripe, Razorpay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Telephony Provider (Twilio)
TELEPHONY_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Speech-To-Text Provider (Deepgram)
STT_PROVIDER=
DEEPGRAM_API_KEY=

# Voice Synthesis Provider (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=

# ============================================================================
# Southeast Asia Regional Integrations (Optional)
# ============================================================================

# Singapore Payments (DBS RAPID & PayNow SGQR)
DBS_RAPID_CLIENT_ID=
DBS_RAPID_API_KEY=
DBS_PAYNOW_PROXY_ID=
DBS_SIGNING_PRIVATE_KEY=

# Malaysia Payments & E-Invoicing (Curlec / DuitNow & LHDN MyInvois)
MY_CURLEC_APP_ID=
MY_CURLEC_SECRET_KEY=
LHDN_MYINVOIS_CLIENT_ID=
LHDN_MYINVOIS_CLIENT_SECRET=
LHDN_DIGITAL_CERT_REF=

# Thailand Payments & E-Tax (PromptPay 2C2P/Omise & Thai RD e-Tax)
TH_OMISE_PUBLIC_KEY=
TH_OMISE_SECRET_KEY=
THAI_RD_ETAX_SERVICE_CODE=
THAI_RD_API_KEY=
THAI_RD_CERTIFICATE_REF=

# LINE Official Account for Thailand (LINE Messaging API)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Regional Messaging Gateway (Multi-Carrier SMS & Viber for SEA)
REGIONAL_SMS_PROVIDER=
REGIONAL_SMS_API_KEY=
REGIONAL_SMS_SENDER_ID=

# Local Communication Services (Regional SIP Trunks: Singtel, Maxis, AIS)
REGIONAL_SIP_TRUNK_DOMAIN=
REGIONAL_SIP_AUTH_USER=
REGIONAL_SIP_PASSWORD=
REGIONAL_CARRIER_PEER=
